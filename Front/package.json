    "test:e2e": "playwright test",
    "test:e2e:types": "tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@sentry/react": "^11.8.0",
    "katex": "^0.18.9",
    "lucide-react": "^1.59.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^6.0.2",
    "vite": "^7.1.0"
