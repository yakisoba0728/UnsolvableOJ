{
  "name": "@unsolvable-oj/front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run build && npm run check:answers && npm run test:e2e:types",
    "check:answers": "node scripts/check-bundle-answers.mjs",
    "test:e2e": "playwright test --project=unit --project=chromium",
    "test:e2e:full": "playwright test",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:types": "tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@sentry/react": "^11.11.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "rehype-katex": {
      "katex": "$katex"
    },
    "micromark-extension-math": {
      "katex": "$katex"
    }
  }
}
