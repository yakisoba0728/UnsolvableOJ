NODE_ENV=development
PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3001

DATABASE_URL=postgresql://unsolvable:local_password@localhost:5432/unsolvable_oj
DATABASE_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# 운영에서는 반드시 충분히 긴 무작위 값으로 교체하세요.
JWT_ACCESS_SECRET=replace-this-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m

# 채점 워커가 내부 API를 호출할 때 X-Judge-Token 헤더로 전송합니다.
JUDGE_SERVICE_TOKEN=replace-this-with-another-32-character-secret
