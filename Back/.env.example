NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# 프록시가 있을 때만 IP/CIDR을 쉼표로 지정하세요. 비워 두면 전달 헤더를 신뢰하지 않습니다.
TRUST_PROXY=
CORS_ORIGIN=http://localhost:3001

DATABASE_URL=postgresql://unsolvable:local_password@localhost:5432/unsolvable_oj
DATABASE_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# 운영에서는 반드시 충분히 긴 무작위 값으로 교체하세요.
JWT_ACCESS_SECRET=replace-this-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m

# 채점 워커가 내부 API를 호출할 때 X-Judge-Token 헤더로 전송합니다.
JUDGE_SERVICE_TOKEN=replace-this-with-another-32-character-secret

# 바이브코딩: 비밀키는 서버에만 주입하며, 비워 두면 AI 대화·평가를 비활성화합니다.
OPENAI_API_KEY=
VIBE_AI_MODEL=gpt-6-luna
# GPT-6 Luna의 reasoning effort는 medium으로 고정합니다.
VIBE_SANDBOX_URL=http://127.0.0.1:5050
# 실행기의 ES_AUTH_TOKEN과 같아야 합니다. 로컬 Compose 기본값입니다.
VIBE_SANDBOX_TOKEN=local-dev-only-go-judge-token-0123456789abcdef

# Optional community email (disabled until a verified sender and real credentials are configured).
EMAIL_ENABLED=false
EMAIL_WORKER_ENABLED=true
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_APP_ORIGIN=
# Generate a dedicated random value >=32 characters; do not reuse JWT secrets.
EMAIL_TOKEN_SECRET=
