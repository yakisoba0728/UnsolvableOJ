{
  "name": "@unsolvable-oj/back",
  "version": "0.0.1",
  "description": "UnsolvableOJ API and judging queue",
  "author": "UnsolvableOJ Team",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "db:migration:run": "npm run build && typeorm migration:run -d dist/database/data-source.js",
    "db:migration:revert": "npm run build && typeorm migration:revert -d dist/database/data-source.js",
    "db:seed:demo": "npm run build && node scripts/seed-demo.mjs",
    "db:import:boj": "npm run build && node scripts/import-boj.mjs",
    "test:boj-import": "node --test scripts/boj-content.test.mjs",
    "db:bootstrap:admin": "npm run build && node scripts/bootstrap-admin.mjs",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "npm run build && node scripts/run-integration.mjs e2e",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:pipeline": "npm run build && node scripts/run-integration.mjs pipeline",
    "test:migrations": "npm run build && node scripts/check-migrations.mjs",
    "test:operations": "node --test scripts/integration-runner.test.mjs",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.7.0",
    "@nestjs/typeorm": "^12.0.1",
    "bullmq": "^6.3.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "joi": "^18.2.9",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@mixmark-io/domino": "^2.2.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
