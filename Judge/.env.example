API_BASE_URL=http://localhost:3000/api/v1
JUDGE_SERVICE_TOKEN=replace-this-with-another-32-character-secret
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
# Optional TLS identity settings. Never disable certificate verification.
REDIS_TLS_SERVERNAME=
REDIS_TLS_CA_FILE=
REDIS_TLS_CERT_FILE=
REDIS_TLS_KEY_FILE=
# embedded keeps private same-host/local HTTP; dedicated requires HTTPS + Redis TLS.
JUDGE_DEPLOYMENT_MODE=embedded
GO_JUDGE_URL=http://127.0.0.1:5050
GO_JUDGE_TOKEN=local-dev-only-go-judge-token-0123456789abcdef
JUDGE_CONCURRENCY=2
