# Dedicated executor host only; never commit the populated .env.
API_BASE_URL=
JUDGE_SERVICE_TOKEN=
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
# Dedicated mode requires verified Redis TLS and an HTTPS API URL.
# For a DNS endpoint this defaults to REDIS_HOST. For an IP, set the certificate DNS name.
REDIS_TLS_SERVERNAME=
GO_JUDGE_TOKEN=
JUDGE_CONCURRENCY=2
# 4 GiB per execution plus 2 GiB runtime/cache headroom; resize with concurrency.
SANDBOX_MEMORY_LIMIT=10g
SANDBOX_CPUS=2.0
JUDGE_MEMORY_LIMIT=512m
JUDGE_CPUS=1.0
