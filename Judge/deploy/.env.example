# Dedicated executor host only; never commit the populated .env.
API_BASE_URL=
JUDGE_SERVICE_TOKEN=
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
GO_JUDGE_TOKEN=
JUDGE_CONCURRENCY=2
# 4 GiB per execution plus 2 GiB runtime/cache headroom; resize with concurrency.
SANDBOX_MEMORY_LIMIT=10g
SANDBOX_CPUS=2.0
JUDGE_MEMORY_LIMIT=512m
