# Configuration input for an OPERATOR-OWNED, independently approved nginx TLS
# gateway on the dedicated host. No gateway image or deployment is provisioned.
# Its container must join the Compose internal network and a controlled private
# inbound network. Provision/review these paths and DNS on the actual host.
server {
    listen 8443 ssl;
    server_name vibe-executor.internal;
    ssl_certificate /run/secrets/vibe_gateway_cert;
    ssl_certificate_key /run/secrets/vibe_gateway_key;
    ssl_client_certificate /run/secrets/vibe_api_client_ca;
    ssl_verify_client on;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    client_max_body_size 1m;
    client_body_timeout 15s;
    keepalive_timeout 5s;
    access_log off;

    # Only the go-judge operations used by Vibe are reachable. No redirects,
    # fallback hosts, URL parameters, added authorization or forwarded identity.
    if ($args != "") { return 400; }
    location ~ "^/(version|config|file|run|file/[A-Za-z0-9_-]{1,200})$" {
        limit_except GET POST DELETE { deny all; }
        proxy_pass http://vibe-sandbox:5050;
        proxy_connect_timeout 3s;
        proxy_read_timeout 45s;
        proxy_send_timeout 15s;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host vibe-sandbox;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header Accept-Encoding identity;
        proxy_buffering off;
    }
    location / { return 404; }
}
