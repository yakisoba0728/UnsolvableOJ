# Single-host Dokploy deployment. Store real values in Environment, never Git.
# Example origin: https://oj.example.com (no trailing slash).
PUBLIC_ORIGIN=

# docker network inspect dokploy-network --format '{{range .IPAM.Config}}{{println .Subnet}}{{end}}'
# Use the actual IPv4 subnet. Do not use 0.0.0.0/0.
TRUSTED_PROXY_CIDR=
# Optional additional proxy hop in X-Forwarded-For, e.g. 172.18.0.1/32.
# Keep loopback when the request path has no additional trusted hop.
TRUSTED_PROXY_HOP_CIDR=127.0.0.1/32

# Generate each value independently: openssl rand -hex 32
# POSTGRES_PASSWORD must be hex because it is interpolated into DATABASE_URL.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_ACCESS_SECRET=
JUDGE_SERVICE_TOKEN=
GO_JUDGE_TOKEN=

# Initial budgets; adjust to host capacity alongside other Dokploy projects.
# Each execution can consume 4 GiB; budget 4 GiB * concurrency + 2 GiB runtime/cache headroom.
JUDGE_CONCURRENCY=2
SANDBOX_CPUS=2.0
SANDBOX_MEMORY_LIMIT=10g
JUDGE_MEMORY_LIMIT=512m
BACK_MEMORY_LIMIT=1g
POSTGRES_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=512m
REDIS_MAXMEMORY=256mb
FRONT_MEMORY_LIMIT=128m
BACKUP_MEMORY_LIMIT=256m
# CPU caps; each value must not exceed the host CPU count.
POSTGRES_CPUS=2.0
BACKUP_CPUS=0.5
REDIS_CPUS=1.0
BACK_CPUS=2.0
JUDGE_CPUS=1.0
FRONT_CPUS=1.0

# Daily pg_dump files older than this many days are deleted after a successful dump.
BACKUP_KEEP_DAYS=7

# Public browser setting, optional. Changing this requires a frontend rebuild.
VITE_SENTRY_DSN=

# Optional: server-only OpenAI credential for vibe coding. Never put it in VITE_* variables.
OPENAI_API_KEY=
