# Single-host Dokploy deployment. Store real values in Environment, never Git.
# Example origin: https://oj.example.com (no trailing slash).
PUBLIC_ORIGIN=

# docker network inspect dokploy-network --format '{{range .IPAM.Config}}{{println .Subnet}}{{end}}'
# Use the actual IPv4 subnet. Do not use 0.0.0.0/0.
TRUSTED_PROXY_CIDR=

# Generate each value independently: openssl rand -hex 32
# POSTGRES_PASSWORD must be hex because it is interpolated into DATABASE_URL.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_ACCESS_SECRET=
JUDGE_SERVICE_TOKEN=
GO_JUDGE_TOKEN=

# Initial budgets; adjust to host capacity alongside other Dokploy projects.
# Concurrent compiles can each consume 1 GiB. Keep headroom for the runtime.
JUDGE_CONCURRENCY=2
SANDBOX_CPUS=2.0
SANDBOX_MEMORY_LIMIT=3g
JUDGE_MEMORY_LIMIT=512m
BACK_MEMORY_LIMIT=1g
POSTGRES_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=512m
REDIS_MAXMEMORY=256mb
FRONT_MEMORY_LIMIT=128m

# Public browser setting, optional. Changing this requires a frontend rebuild.
VITE_SENTRY_DSN=
